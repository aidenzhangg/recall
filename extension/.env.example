# Copy this file to .env.local (Git ignores it) and rebuild. Never commit a real key.
#
# A shared AI key for everyone who uses your build, so they do not need their own.
# Warning: the key ends up inside the built extension, where anyone who installs it can read it.
# Only use a free key with no payment method attached, and revoke it if it is abused.
VITE_AI_PROVIDER=groq
VITE_AI_KEY=
# Optional. Defaults: llama-3.3-70b-versatile for groq, gemini-2.5-flash for gemini.
VITE_AI_MODEL=

# Optional hosted backend for accounts and sync, e.g. https://your-address/api
# VITE_API_BASE=

# Accounts on Supabase: sign-in becomes the first screen and progress is saved to the account, not the device.
# Use the Project URL and the anon / publishable key (Project Settings -> API). These two are safe to ship.
# NEVER put the service_role or secret key here. Run supabase/schema.sql in the project first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
